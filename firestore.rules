rules_version = '2';
// Earshot database rules: anyone can read the leaderboards; players can only write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per player, keyed by their sign-in id
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // One document per finished round; can be added by its own player, never edited
    match /results/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
